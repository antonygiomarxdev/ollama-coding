# Ollama - Override auto-selected model (optional). Leave empty for hardware-based default.
# Prefer qwen3-coder (v3) when VRAM allows, e.g. qwen3-coder:30b-a3b-q4_K_M. Others: llama3.2, mistral, qwen2.5-coder:7b
OLLAMA_MODEL=

# Ngrok - Get your token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Ngrok reserved domain (optional). Leave empty for a random URL.
# Example: my-app.ngrok-free.dev
NGROK_DOMAIN=
