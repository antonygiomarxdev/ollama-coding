# Ollama - Override auto-selected model (optional). Leave empty for hardware-based default.
# Prefer qwen3-coder (v3) when VRAM allows, e.g. qwen3-coder:30b-a3b-q4_K_M. Others: llama3.2, mistral, qwen2.5-coder:7b
OLLAMA_MODEL=

# Multi-GPU: leave empty to use all NVIDIA GPUs. Set to e.g. "0,1" to use only GPU 0 and 1. Total VRAM is summed for model selection.
# CUDA_VISIBLE_DEVICES=

# Parallel requests (optional). Increase for multi-GPU or high-memory systems. Default is 1.
# OLLAMA_NUM_PARALLEL=

# Vulkan (optional). Set to 1 for experimental Intel/AMD GPU support when using the default NVIDIA image.
# OLLAMA_VULKAN=

# Ngrok - Get your token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Ngrok reserved domain (optional). Leave empty for a random URL.
# Example: my-app.ngrok-free.dev
NGROK_DOMAIN=
