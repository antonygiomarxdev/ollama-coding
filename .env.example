# Ollama - Override auto-selected model (optional). Leave empty for hardware-based default (qwen3-coder).
# Examples: llama3.2, mistral, codellama, deepseek-coder, qwen2.5-coder
OLLAMA_MODEL=

# Ngrok - Get your token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Ngrok reserved domain (optional). Leave empty for a random URL.
# Example: my-app.ngrok-free.dev
NGROK_DOMAIN=
