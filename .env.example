# Modelo a usar. Vacío = auto según VRAM. Solo Qwen 3 Coder:
#   qwen3-coder:30b-a3b-q4_K_M  (~19GB VRAM)
#   qwen3-coder:30b-a3b-q8_0    (~32GB VRAM)
#   qwen3-coder:30b-a3b-fp16    (~61GB VRAM)
OLLAMA_MODEL=

# Multi-GPU: vacío = todas las NVIDIA. Ej: "0,1" para solo GPU 0 y 1.
# CUDA_VISIBLE_DEVICES=

# Peticiones en paralelo (opcional). Por defecto 1.
# OLLAMA_NUM_PARALLEL=

# Vulkan (opcional). 1 para Intel/AMD con la imagen por defecto.
# OLLAMA_VULKAN=
